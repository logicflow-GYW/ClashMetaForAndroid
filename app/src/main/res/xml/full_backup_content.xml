<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include
        domain="sharedpref"
        path="." />
    <!-- CF optimizer Worker password ciphertext: device-bound Keystore key cannot
         decrypt a restored blob, so the secret never leaves the device. -->
    <exclude
        domain="sharedpref"
        path="cfoptimizer_secret.xml" />
    <include
        domain="database"
        path="." />
    <include
        domain="file"
        path="imported" />
    <include
        domain="file"
        path="pending" />
    <include
        domain="file"
        path="clash/override.json" />
</full-backup-content>
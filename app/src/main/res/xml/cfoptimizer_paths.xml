<?xml version="1.0" encoding="utf-8"?>
<!--
  CF 优选「导出运行数据」的文件根。

  1) 下载目录下的导出子文件夹 —— 导出的落点（Android 11+ 用户能直接用文件管理器打开）。
  2) 应用专属外部目录 —— 老系统上直写下载目录被拒时的回落落点。

  只暴露这两个子目录（不放开整个外部存储或 files/），FileProvider 只允许
  getUriForFile 命中这里的文件 —— 分享出去的 URI 权限最小。
-->
<paths>
    <external-path
        name="cfoptimizer_downloads"
        path="Download/CF优选/" />

    <external-files-path
        name="cfoptimizer"
        path="cfoptimizer/" />
</paths>

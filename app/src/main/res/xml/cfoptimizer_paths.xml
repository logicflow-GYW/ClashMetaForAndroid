<?xml version="1.0" encoding="utf-8"?>
<!--
  CF 优选「导出运行数据」的文件根：Android/data/<applicationId>/files/cfoptimizer/

  只暴露这一个子目录（不放开整个 files/ 或外部存储），FileProvider 只允许
  getUriForFile 命中这里的文件 —— 分享出去的 URI 权限最小。
-->
<paths>
    <external-files-path
        name="cfoptimizer"
        path="cfoptimizer/" />
</paths>
